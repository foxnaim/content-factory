# Runtime
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=content_factory
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=content_factory
POSTGRES_PORT=55432
DATABASE_URL=postgresql://content_factory:replace-with-a-long-random-password@localhost:55432/content_factory?schema=public

# Redis / BullMQ
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379
SCRIPT_CONCURRENCY=2
ASSET_CONCURRENCY=2
VOICE_CONCURRENCY=2
RENDER_CONCURRENCY=1
NOTIFY_CONCURRENCY=2
DOCKER_WORKER_STAGES=script,assets,voice,render,notify
JOB_ATTEMPTS=4
JOB_BACKOFF_MS=2000

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=content_factory_local
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
MINIO_SOURCE_BUCKET=content-factory-source
MINIO_WORK_BUCKET=content-factory-work
MINIO_OUTPUT_BUCKET=content-factory-output

# Local providers
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
DOCKER_OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OPENTTS_URL=
DOCKER_OPENTTS_URL=
OPENTTS_VOICE=en_US-amy-medium
FFMPEG_PATH=ffmpeg
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30

# Host-only alternative that uses an existing Codex CLI login/subscription.
# Do not copy CODEX_HOME or auth files into containers. Run the worker on the owner machine.
# LLM_PROVIDER=codex-cli
# CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
# CODEX_MODEL=
# CODEX_TIMEOUT_MS=180000
# CODEX_OUTPUT_SCHEMA_PATH=packages/shared/src/schemas/video-script.schema.json

# Telegram readiness notification (disabled by default)
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=

# n8n manual integrations only
N8N_ENCRYPTION_KEY=replace-with-a-long-random-key
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
